      "locked": false,
      "name": "8. Soft-delete vs Force-delete (user as the canonical example)"
    },
    {
      "id": "text-362",
      "type": "text",
      "x": 150,
      "y": 5660,
      "width": 1600,
      "height": 20,
      "angle": 0,
      "strokeColor": "#212529",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": "frame-361",
      "roundness": null,
      "seed": 1722,
      "versionNonce": 1723,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1700000000000,
      "link": null,
      "locked": false,
      "fontSize": 14,
      "fontFamily": 1,
      "text": "Soft = flip status to DELETED on parent + aliases (profiles physically removed). Force = physical DELETE children-then-parent; S3 cleanup outside the UoW.",
      "textAlign": "left",
      "verticalAlign": "middle",
      "baseline": 11,
      "containerId": null,
      "originalText": "Soft = flip status to DELETED on parent + aliases (profiles physically removed). Force = physical DELETE children-then-parent; S3 cleanup outside the UoW.",
      "lineHeight": 1.25
    },
