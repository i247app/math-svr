      "link": null,
      "locked": false,
      "fontSize": 11,
      "fontFamily": 1,
      "text": "If the translation row is missing in the requested language, JOIN drops the parent row \u2014 always seed VN + EN together.",
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 9,
      "containerId": null,
      "originalText": "If the translation row is missing in the requested language, JOIN drops the parent row \u2014 always seed VN + EN together.",
      "lineHeight": 1.25
    },
