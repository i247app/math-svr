# root
GEX_SHARED_KEY=hmac.key
GEX_SESSION_DRIVER=

# server
SERVER_MODE=development
SERVER_HOST=localhost
SERVER_PORT=8080
SERIALIZED_SESSION_FILE=
# true → also write SERIALIZED_SESSION_FILE on every login/logout, not only on graceful shutdown
SESSION_PERSIST_ON_CHANGE=false
# proof of work on POST /exams/generate (see /pow/challenge + /pow/verify)
POW_ENABLED=false
# leading hex zeros required; each +1 = 16x more client work
POW_DIFFICULTY=5
LOG_FILE=
LOG_CONSOLE_FORMAT=
LOG_FORMAT=

# otp & flag
ENABLE_OTP=true
OTP_BYPASS_ENABLED=true
OTP_BYPASS_CODE=
TRUST_DEVICE_TTL=
DEMO_NAMES=
EXAM_SHUFFLE_ENABLED=true

#db
DB_USER=
DB_HOST=
DB_PORT=
DB_NAME=
DB_PASS=
DB_PASS=

# storage
STORAGE_PROVIDER=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=
STORAGE_BUCKET=

# mailer
EMAIL_PROVIDER=
GMAIL_CREDENTIALS_FILE=
GMAIL_SENDER_EMAIL=

# twilio
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

SMS_TIMEOUT=10s
SMS_MAX_RETRIES=2
SMS_RETRY_DELAY=250ms
SMS_REQUIRE_AT_BOOT=false

# bot — AI/chat adapter (internal/adapter/bot)
# Default provider: "langchain" | "eino" | "openrouter" | "openai"
# | "gemini" | "deepseek" | "" | "disabled".
# Every framework whose config key is set gets registered on the adapter
# (BOT_LANGCHAIN_BACKEND / BOT_EINO_BACKEND / BOT_OPENROUTER_API_KEY /
# BOT_OPENAI_API_KEY / BOT_GEMINI_API_KEY / BOT_DEEPSEEK_API_KEY);
# BOT_PROVIDER names which one
# serves calls by default.
#
# NOTE "openai" and "gemini" are provider names here, and the SAME vendors
# appear as backend names below ("openai" / "googleai"). As BOT_PROVIDER
# they mean the DIRECT clients (app → api.openai.com,
# app → generativelanguage.googleapis.com). As BOT_LANGCHAIN_BACKEND /
# BOT_EINO_BACKEND they mean "the SDK should talk to that vendor".
# Different keys, no collision — but read twice.
BOT_PROVIDER=langchain

# langchain framework (registered when BOT_LANGCHAIN_BACKEND is non-empty)
# Backend selects the LLM vendor wired inside libs/langchain:
#   "googleai" | "openai" | "anthropic" | "ollama"
BOT_LANGCHAIN_BACKEND=googleai
BOT_LANGCHAIN_API_KEY=
BOT_LANGCHAIN_BASE_URL=
BOT_LANGCHAIN_MODEL=gemini-1.5-flash
BOT_LANGCHAIN_EMBED_MODEL=text-embedding-004
# Sampling overrides — leave blank to use vendor defaults.
BOT_LANGCHAIN_TEMPERATURE=
BOT_LANGCHAIN_TOP_P=
BOT_LANGCHAIN_MAX_TOKENS=

# eino framework (cloudwego/eino + eino-ext; registered when
# BOT_EINO_BACKEND is non-empty). Same backend vocabulary as langchain:
#   "googleai" | "openai" | "anthropic" | "ollama"
# Note: the eino provider supports Chat + Stream; Embed is unsupported.
BOT_EINO_BACKEND=
BOT_EINO_API_KEY=
BOT_EINO_BASE_URL=
BOT_EINO_MODEL=
# Sampling overrides — leave blank to use vendor defaults.
BOT_EINO_TEMPERATURE=
BOT_EINO_TOP_P=
BOT_EINO_MAX_TOKENS=
# Send chat-completions `store: true` so each request AND response shows up
# at https://platform.openai.com/logs. OPENAI BACKEND ONLY (googleai /
# anthropic / ollama ignore it). Default false.
# WARNING: enabling this stores prompt + response content on OpenAI for 30
# days, readable by anyone with dashboard access.
BOT_EINO_STORE=false

# openrouter framework (https://openrouter.ai — direct REST, no SDK;
# registered when BOT_OPENROUTER_API_KEY is non-empty).
# Unlike the two above there is NO backend key: OpenRouter is itself the
# router and BOT_OPENROUTER_MODEL ("vendor/model-name") picks the vendor.
# Note: the openrouter provider supports Chat + Stream; Embed is unsupported.
BOT_OPENROUTER_API_KEY=
# REQUIRED when the API key is set — there is no built-in default model,
# because defaulting it would pick a vendor and a price for you.
# Examples: "openai/gpt-4o-mini", "anthropic/claude-3.5-sonnet",
#           "google/gemini-2.0-flash-001"
BOT_OPENROUTER_MODEL=
# Optional; defaults to https://openrouter.ai/api/v1
BOT_OPENROUTER_BASE_URL=
# Attribution only — these control whether your app shows up on
# OpenRouter's public rankings. They never affect whether a call succeeds.
#   BOT_OPENROUTER_SITE_URL  → "HTTP-Referer" header
#   BOT_OPENROUTER_APP_TITLE → "X-OpenRouter-Title" header
BOT_OPENROUTER_SITE_URL=
BOT_OPENROUTER_APP_TITLE=
# Sampling overrides — leave blank to use the model's defaults.
BOT_OPENROUTER_TEMPERATURE=
BOT_OPENROUTER_TOP_P=
BOT_OPENROUTER_MAX_TOKENS=

# openai framework — DIRECT connection to api.openai.com (no SDK, no
# broker; registered when BOT_OPENAI_API_KEY is non-empty). Use this when
# usage, rate limits and the platform.openai.com/logs dashboard must be
# attributable to this account's own key.
# Model id is a BARE OpenAI name ("gpt-4.1"), not OpenRouter's
# "vendor/model" form.
# Note: this is the only provider besides langchain that supports Embed.
BOT_OPENAI_API_KEY=
# REQUIRED when the API key is set — no built-in default, because
# defaulting it would pick a price for you. e.g. "gpt-4.1", "gpt-4o-mini"
BOT_OPENAI_MODEL=
# Optional; only needed for Embed. e.g. "text-embedding-3-small"
BOT_OPENAI_EMBED_MODEL=
# Optional; defaults to https://api.openai.com/v1
BOT_OPENAI_BASE_URL=
# Optional scoping headers. Project-scoped keys (sk-proj-...) already carry
# their project, so these are only needed for legacy user-level keys or
# multi-org accounts.
BOT_OPENAI_ORGANIZATION=
BOT_OPENAI_PROJECT=
# Send `store: true` so each request AND response shows up at
# https://platform.openai.com/logs. Default false.
# WARNING: enabling this retains prompt + response content on OpenAI for 30
# days, readable by anyone with dashboard access.
BOT_OPENAI_STORE=false
# Sampling overrides — leave blank to use the model's defaults.
# NOTE: reasoning models (gpt-5*, gpt-5.6-*, the o-series) accept ONLY the
# default temperature/top_p and answer any override with HTTP 400. The
# client detects that once per model, drops both fields and retries, so
# these keys are simply inert there — see libs/openai postChat.
BOT_OPENAI_TEMPERATURE=
BOT_OPENAI_TOP_P=
BOT_OPENAI_MAX_TOKENS=
# How much hidden reasoning the model does before answering. Blank sends
# nothing (model default). One of: none | minimal | low | medium | high |
# xhigh | max — anything else fails at boot.
#   none  -> for latency-critical work: no reasoning pass, so the first
#            token comes back at non-reasoning speed. Supported by the
#            gpt-5.6 family; gpt-6-astra REJECTS it with HTTP 400.
# Leave blank for non-reasoning models (gpt-4.1, gpt-4o) — they have no
# reasoning pass and the field only risks a 400 from an older endpoint.
BOT_OPENAI_REASONING_EFFORT=

# gemini framework — DIRECT connection to generativelanguage.googleapis.com
# (no SDK, no broker; registered when BOT_GEMINI_API_KEY is non-empty).
# Use this when quota, rate limits and billing must be attributable to this
# account's own key rather than to a broker's.
# Model id is a bare name ("gemini-2.0-flash"); the "models/" URL prefix is
# added by the client, and supplying it yourself is harmless.
# Note: supports Chat, Stream and Embed.
BOT_GEMINI_API_KEY=
# REQUIRED when the API key is set — no built-in default, because
# defaulting it would pick a price for you. e.g. "gemini-2.0-flash"
BOT_GEMINI_MODEL=
# Optional; only needed for Embed. e.g. "text-embedding-004"
BOT_GEMINI_EMBED_MODEL=
# Optional; defaults to https://generativelanguage.googleapis.com/v1beta
BOT_GEMINI_BASE_URL=
# Sampling overrides — leave blank to use the model's defaults.
BOT_GEMINI_TEMPERATURE=
BOT_GEMINI_TOP_P=
BOT_GEMINI_MAX_TOKENS=

# deepseek framework — DIRECT connection to api.deepseek.com (no SDK, no
# broker; registered when BOT_DEEPSEEK_API_KEY is non-empty).
# DeepSeek is OpenAI-compatible but reads `max_tokens` (not
# `max_completion_tokens`) and signals an empty balance with HTTP 402.
# Note: supports Chat + Stream; Embed is unsupported (no endpoint).
BOT_DEEPSEEK_API_KEY=
# REQUIRED when the API key is set — no built-in default, because
# defaulting it would pick a price for you.
# e.g. "deepseek-v4-flash", "deepseek-v4-pro"
BOT_DEEPSEEK_MODEL=deepseek-v4-flash
# Optional; defaults to https://api.deepseek.com
# Point at https://api.deepseek.com/beta for the beta surface.
BOT_DEEPSEEK_BASE_URL=https://api.deepseek.com
# Thinking mode. Leave blank to use the model's own default.
#   BOT_DEEPSEEK_THINKING:         "enabled" | "disabled"
#   BOT_DEEPSEEK_REASONING_EFFORT: "low" | "high" | "max"
# Set THINKING=disabled when you only need quiz JSON: reasoning tokens are
# billed on top of the answer and this repo discards the reasoning text.
BOT_DEEPSEEK_THINKING=
BOT_DEEPSEEK_REASONING_EFFORT=
# Sampling overrides — leave blank to use the model's defaults.
BOT_DEEPSEEK_TEMPERATURE=
BOT_DEEPSEEK_TOP_P=
BOT_DEEPSEEK_MAX_TOKENS=

# Transport tuning (shared by all six bot frameworks)
BOT_TIMEOUT=60s
BOT_MAX_RETRIES=2
BOT_RETRY_DELAY=500ms
BOT_REQUIRE_AT_BOOT=false

# notification
NOTIFICATION_PROVIDER=firebase
FIREBASE_CREDENTIALS_FILE=
FIREBASE_PROJECT_ID=

# ── Observability (metrics + tracing) ────────────────────────────────
# Identity attached to metrics build_info and trace resource attributes.
OBS_SERVICE_NAME=math-svr
OBS_SERVICE_VERSION=dev
OBS_ENV=local

# Metrics (Prometheus). Served on a DEDICATED listener, separate from the API
# port and free of app middleware.
OBS_METRICS_ENABLED=true
# LOCAL: ":9091" (all interfaces) so Prometheus-in-Docker can scrape via
# host.docker.internal:9091.
# PRODUCTION: bind to loopback → "127.0.0.1:9091" so /metrics is NOT reachable
# from the public internet; scrape it with a node-local Prometheus/agent.
OBS_METRICS_ADDR=:9091

# Tracing (OpenTelemetry → Tempo via OTLP/HTTP).
OBS_TRACING_ENABLED=true
# host:port of the OTLP HTTP receiver (no scheme). LOCAL: localhost:4318.
# PRODUCTION: your collector/agent endpoint (NOT host.docker.internal).
OBS_OTLP_ENDPOINT=localhost:4318
# true → no TLS (local). PRODUCTION with a TLS collector: false.
OBS_OTLP_INSECURE=true
# Head sampling ratio. LOCAL: 1.0 (sample everything). PRODUCTION: 0.05–0.1.
# ParentBased is applied, so an upstream sampling decision is always honoured.
OBS_TRACE_SAMPLE_RATIO=1.0

# ------------------------------------------------------------------------------
# Realtime WebSocket (internal/infrastructure/socket). Endpoint: GET /ws/connect
# ------------------------------------------------------------------------------
# false → the socket runtime is not built and /ws/connect is not registered.
SOCKET_ENABLED=true
# CSRF guard: comma-separated Origin host patterns passed to websocket.Accept as
# OriginPatterns. Empty Origin (native mobile) is always allowed; an empty list
# rejects every browser origin. PRODUCTION: list your web origins, e.g.
# "app.example.com,admin.example.com". LOCAL: leave blank or "localhost:*".
SOCKET_ALLOWED_ORIGINS=
# Optional tuning — blank/zero uses the Hub defaults shown in brackets.
SOCKET_PING_INTERVAL=30s      # [30s] server→client keepalive ping cadence
SOCKET_WRITE_TIMEOUT=10s      # [10s] per-frame write / ping deadline
SOCKET_READ_LIMIT=32768       # [32768] max inbound frame size, bytes
SOCKET_WRITE_BUFFER=64        # [64] per-conn outbound queue depth before a slow consumer is dropped
SOCKET_MAX_CONNS_PER_USER=5   # [5] cap on simultaneous connections per user


