# root
ROOT_SHARED_KEY=hmac.key
ROOT_SESSION_DRIVER=

# server
PORT=8000
LOG_FILE_PATH=log_file
SERIALIZED_SESSION_FILE=

#db
DB_USER=
DB_HOST=
DB_PORT=
DB_NAME=
DB_PASSWORD=
DB_ROOT_PASSWORD=

# host-config
SERVER_HOST=localhost
SERVER_PORT=8080

# mailer
MAIL_PORT=
MAIL_HOST=
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=

# twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# chatbox - Choose provider: "openai", "google", "langchain", or "mock"
CHAT_BOX_PROVIDER=google
CHAT_BOX_API_KEY=
CHAT_BOX_TEST_MODE=false

# LangChain specific settings (only used when CHAT_BOX_PROVIDER=langchain)
# Choose LangChain sub-provider: "openai" or "google"
CHAT_BOX_LANGCHAIN_PROVIDER=google
CHAT_BOX_MODEL_NAME=

# OpenTelemetry Configuration
OTEL_ENABLE_TRACING=true
OTEL_ENABLE_METRICS=true
OTEL_SERVICE_NAME=math-srv
OTEL_SERVICE_VERSION=1.0.0
OTEL_ENVIRONMENT=development

# OTLP Exporter (for Jaeger)
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4318
OTEL_EXPORTER_OTLP_INSECURE=true

# Trace Sampling (0.0 to 1.0, where 1.0 = 100%)
OTEL_TRACE_SAMPLE_RATE=1.0

# Prometheus (app exposes metrics on this port)
OTEL_PROMETHEUS_PORT=9091

