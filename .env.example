# root
ROOT_SHARED_KEY=hmac.key
ROOT_SESSION_DRIVER=

# server
PORT=8000
LOG_FILE_PATH=log_file
SERIALIZED_SESSION_FILE=

#db
DB_USER=
DB_HOST=
DB_PORT=
DB_NAME=
DB_PASS=
DB_ROOT_PASSWORD=

# host-config
SERVER_HOST=localhost
SERVER_PORT=8080

# mailer
MAIL_PORT=
MAIL_HOST=
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=

# twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# bot — AI/chat adapter (internal/adapter/bot)
# Choose adapter provider: "langchain" | "" | "disabled"
BOT_PROVIDER=langchain

# langchain backend (only consumed when BOT_PROVIDER=langchain)
# Backend selects the LLM vendor wired inside libs/langchain:
#   "googleai" | "openai" | "anthropic" | "ollama"
BOT_LANGCHAIN_BACKEND=googleai
BOT_LANGCHAIN_API_KEY=
BOT_LANGCHAIN_BASE_URL=
BOT_LANGCHAIN_MODEL=gemini-1.5-flash
BOT_LANGCHAIN_EMBED_MODEL=text-embedding-004
# Sampling overrides — leave blank to use vendor defaults.
BOT_LANGCHAIN_TEMPERATURE=
BOT_LANGCHAIN_TOP_P=
BOT_LANGCHAIN_MAX_TOKENS=

# Transport tuning
BOT_TIMEOUT=60s
BOT_MAX_RETRIES=2
BOT_RETRY_DELAY=500ms
BOT_REQUIRE_AT_BOOT=false

# AI Conversation (multi-turn chat) tuning
# Master toggle for re-sending prior turns as context. false → each turn
# sends only the system prompt + the new user message (messages still saved).
CONVERSATION_HISTORY_WINDOW_ENABLED=true
# How many recent messages are re-sent when the window is enabled.
CONVERSATION_HISTORY_WINDOW_SIZE=20
# Max characters allowed in a single user message.
CONVERSATION_MAX_MESSAGE_CHARS=4000



