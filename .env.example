# Values in [brackets] are the defaults used when a key is blank or absent.
# Keep "" on an empty value that has a comment: godotenv reads KEY=  # note as "# note".

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
SERVER_MODE=development  # not read by the loader
SERVER_HOST=localhost    # bind address
SERVER_PORT=8080         # bind port
HTTPS_CERT_FILE=""       # TLS cert path; set both to serve HTTPS
HTTPS_KEY_FILE=""        # TLS key path

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
GEX_SHARED_KEY=hmac.key  # path to the HMAC key file that signs session tokens; required
GEX_SESSION_DRIVER=""    # xwt | anything else = jwt
ADMIN_API_KEY=""         # X-Api-Admin-Key secret for admin routes; empty = disabled; openssl rand -hex 32
RATE_LIMIT_MODE=shadow   # off | shadow (log + metric, never blocks) | enforce

# ---------------------------------------------------------------------------
# Session
# ---------------------------------------------------------------------------
SERIALIZED_SESSION_FILE=""       # file sessions are saved to on shutdown and reloaded on boot; empty = off
SESSION_PERSIST_ON_CHANGE=false  # true = also save on every login/logout; needs SERIALIZED_SESSION_FILE

# ---------------------------------------------------------------------------
# Auth & OTP
# ---------------------------------------------------------------------------
ENABLE_OTP=true          # read but not used by the login flow today
OTP_BYPASS_ENABLED=true  # DEV/TEST ONLY - OTP_BYPASS_CODE verifies any pending OTP; never true in prod
OTP_BYPASS_CODE=""       # the bypass code
TRUST_DEVICE_TTL=""      # days a verified device skips OTP [30]
DEMO_NAMES=""            # CSV of demo accounts that skip real OTP delivery and device checks
EMAIL_OTP_ENABLE=false   # /users/identifier-available tells the client a new email needs an OTP
PHONE_OTP_ENABLE=false   # same, for a new phone number

# ---------------------------------------------------------------------------
# Exam
# ---------------------------------------------------------------------------
EXAM_SHUFFLE_ENABLED=true  # per-sitting question/answer order; only the literal "false" turns it off
POW_ENABLED=false          # require a proof of work (/pow/*) before POST /exams/generate
POW_DIFFICULTY=5           # leading hex zeros [4]; each +1 = 16x more client work

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_FILE=""            # log file path; empty = console only
LOG_CONSOLE_FORMAT=""  # text | json [text]
LOG_FILE_FORMAT=""     # text | json [json]; json for Loki
LOG_FORMAT=""          # text | json; overrides both console and file formats

# ---------------------------------------------------------------------------
# Database (MySQL)
# ---------------------------------------------------------------------------
DB_USER=
DB_HOST=
DB_PORT=
DB_NAME=
DB_PASS=""                # DB_USER..DB_PASS are required
DB_MAX_OPEN_CONNS=""      # [25]
DB_MAX_IDLE_CONNS=""      # [10]
DB_CONN_MAX_LIFETIME=""   # seconds [300]
DB_CONN_MAX_IDLE_TIME=""  # seconds [180]

# ---------------------------------------------------------------------------
# Storage (S3)
# ---------------------------------------------------------------------------
STORAGE_PROVIDER=""  # s3 [s3]
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=
STORAGE_BUCKET=

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------
EMAIL_PROVIDER=""          # google (the only accepted value); required
GMAIL_CREDENTIALS_FILE=""  # path to the Gmail API credentials JSON
GMAIL_SENDER_EMAIL=""      # From address
EMAIL_HOST=""              # SMTP settings: read but not used by the Gmail API provider
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=

# ---------------------------------------------------------------------------
# SMS (Twilio)
# ---------------------------------------------------------------------------
SMS_PROVIDER=twilio            # twilio | "" or disabled = off
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=""                 # sender phone number
TWILIO_BASE_URL=""             # [https://api.twilio.com]
TWILIO_FROM_PHONE_NUMBER=""    # NOT read - use TWILIO_FROM
TWILIO_MESSAGING_SERVICE_SID=
SMS_TIMEOUT=10s                # per-request timeout
SMS_MAX_RETRIES=2
SMS_RETRY_DELAY=250ms
SMS_REQUIRE_AT_BOOT=false      # true = probe Twilio credentials at boot; boot fails if they are wrong

# ---------------------------------------------------------------------------
# LLM
# ---------------------------------------------------------------------------
# Every provider whose API key is set is registered; LLM_PROVIDER picks the default.
LLM_PROVIDER=openai        # openrouter | openai | gemini | deepseek | "" or disabled = off
LLM_TIMEOUT=60s            # transport settings below are shared by every provider
LLM_MAX_RETRIES=2
LLM_RETRY_DELAY=500ms
LLM_REQUIRE_AT_BOOT=false  # true = probe each provider at boot; boot fails if one is unreachable

# ---------------------------------------------------------------------------
# LLM - OpenRouter
# ---------------------------------------------------------------------------
# Direct REST, no SDK. Chat + Stream only (no Embed).
LLM_OPENROUTER_API_KEY=""      # set to register the provider
LLM_OPENROUTER_MODEL=""        # required with the key; vendor/model, e.g. openai/gpt-4o-mini
LLM_OPENROUTER_BASE_URL=""     # [https://openrouter.ai/api/v1]
LLM_OPENROUTER_SITE_URL=""     # HTTP-Referer header; attribution only
LLM_OPENROUTER_APP_TITLE=""    # X-OpenRouter-Title header; attribution only
LLM_OPENROUTER_TEMPERATURE=""  # blank = model default
LLM_OPENROUTER_TOP_P=""        # blank = model default
LLM_OPENROUTER_MAX_TOKENS=""   # blank = model default

# ---------------------------------------------------------------------------
# LLM - OpenAI
# ---------------------------------------------------------------------------
# Direct REST, no SDK. Chat, Stream, Embed and the Responses API (journey context).
LLM_OPENAI_API_KEY=""           # set to register the provider
LLM_OPENAI_MODEL=""             # required with the key; bare name, e.g. gpt-4.1
LLM_OPENAI_EMBED_MODEL=""       # only for Embed, e.g. text-embedding-3-small
LLM_OPENAI_BASE_URL=""          # [https://api.openai.com/v1]
LLM_OPENAI_ORGANIZATION=""      # only for legacy user keys / multi-org accounts
LLM_OPENAI_PROJECT=""           # only for legacy user keys / multi-org accounts
LLM_OPENAI_STORE=false          # WARNING: true keeps prompts + responses on OpenAI for 30 days (dashboard logs)
LLM_OPENAI_TEMPERATURE=""       # blank = model default; ignored by reasoning models
LLM_OPENAI_TOP_P=""             # blank = model default; ignored by reasoning models
LLM_OPENAI_MAX_TOKENS=""        # blank = model default
LLM_OPENAI_REASONING_EFFORT=""  # none|minimal|low|medium|high|xhigh|max; blank for non-reasoning models

# ---------------------------------------------------------------------------
# LLM - Gemini
# ---------------------------------------------------------------------------
# Direct REST, no SDK. Chat, Stream and Embed.
LLM_GEMINI_API_KEY=""      # set to register the provider
LLM_GEMINI_MODEL=""        # required with the key; bare name, e.g. gemini-2.0-flash
LLM_GEMINI_EMBED_MODEL=""  # only for Embed, e.g. text-embedding-004
LLM_GEMINI_BASE_URL=""     # [https://generativelanguage.googleapis.com/v1beta]
LLM_GEMINI_TEMPERATURE=""  # blank = model default
LLM_GEMINI_TOP_P=""        # blank = model default
LLM_GEMINI_MAX_TOKENS=""   # blank = model default

# ---------------------------------------------------------------------------
# LLM - DeepSeek
# ---------------------------------------------------------------------------
# Direct REST, no SDK. Chat + Stream only (no Embed).
LLM_DEEPSEEK_API_KEY=""                         # set to register the provider
LLM_DEEPSEEK_MODEL=deepseek-v4-flash            # required with the key; e.g. deepseek-v4-flash, deepseek-v4-pro
LLM_DEEPSEEK_BASE_URL=https://api.deepseek.com  # use https://api.deepseek.com/beta for the beta surface
LLM_DEEPSEEK_THINKING=""                        # enabled | disabled; disabled saves billed reasoning tokens
LLM_DEEPSEEK_REASONING_EFFORT=""                # low | high | max; blank = model default
LLM_DEEPSEEK_TEMPERATURE=""                     # blank = model default
LLM_DEEPSEEK_TOP_P=""                           # blank = model default
LLM_DEEPSEEK_MAX_TOKENS=""                      # blank = model default

# ---------------------------------------------------------------------------
# Notification (Firebase push)
# ---------------------------------------------------------------------------
NOTIFICATION_PROVIDER=firebase  # firebase | "" or disabled = off
FIREBASE_CREDENTIALS_FILE=""    # path to the service-account JSON
FIREBASE_PROJECT_ID=

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
OBS_SERVICE_NAME=math-svr         # service identity on metrics and traces
OBS_SERVICE_VERSION=dev
OBS_ENV=local
OBS_METRICS_ENABLED=true          # Prometheus /metrics on its own listener
OBS_METRICS_ADDR=:9091            # prod: 127.0.0.1:9091 so /metrics is not public
OBS_TRACING_ENABLED=true          # OpenTelemetry -> Tempo
OBS_OTLP_ENDPOINT=localhost:4318  # OTLP/HTTP host:port, no scheme
OBS_OTLP_INSECURE=true            # true = no TLS (local); false for a TLS collector
OBS_TRACE_SAMPLE_RATIO=1.0        # 1.0 local; 0.05-0.1 in prod

# ---------------------------------------------------------------------------
# Realtime WebSocket (GET /ws/connect)
# ---------------------------------------------------------------------------
SOCKET_ENABLED=true          # false = /ws/connect is not registered
SOCKET_ALLOWED_ORIGINS=""    # CSV of browser Origin patterns; native clients always pass
SOCKET_PING_INTERVAL=30s     # [30s] keepalive ping cadence
SOCKET_WRITE_TIMEOUT=10s     # [10s] per-frame write deadline
SOCKET_READ_LIMIT=32768      # [32768] max inbound frame, bytes
SOCKET_WRITE_BUFFER=64       # [64] outbound queue before a slow client is dropped
SOCKET_MAX_CONNS_PER_USER=5  # [5] simultaneous connections per user
