# root
ROOT_SHARED_KEY=hmac.key
ROOT_SESSION_DRIVER=

# server
PORT=8000
LOG_FILE_PATH=log_file
SERIALIZED_SESSION_FILE=

#db
DB_USER=
DB_HOST=
DB_PORT=
DB_NAME=
DB_PASS=
DB_ROOT_PASSWORD=

# host-config
SERVER_HOST=localhost
SERVER_PORT=8080

# mailer
MAIL_PORT=
MAIL_HOST=
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=

# twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# bot — AI/chat adapter (internal/adapter/bot)
# Choose adapter provider: "langchain" | "" | "disabled"
BOT_PROVIDER=langchain

# langchain backend (only consumed when BOT_PROVIDER=langchain)
# Backend selects the LLM vendor wired inside libs/langchain:
#   "googleai" | "openai" | "anthropic" | "ollama"
BOT_LANGCHAIN_BACKEND=googleai
BOT_LANGCHAIN_API_KEY=
BOT_LANGCHAIN_BASE_URL=
BOT_LANGCHAIN_MODEL=gemini-1.5-flash
BOT_LANGCHAIN_EMBED_MODEL=text-embedding-004
# Sampling overrides — leave blank to use vendor defaults.
BOT_LANGCHAIN_TEMPERATURE=
BOT_LANGCHAIN_TOP_P=
BOT_LANGCHAIN_MAX_TOKENS=

# Transport tuning
BOT_TIMEOUT=60s
BOT_MAX_RETRIES=2
BOT_RETRY_DELAY=500ms
BOT_REQUIRE_AT_BOOT=false

# AI Conversation (multi-turn chat) tuning
# Master toggle for re-sending prior turns as context. false → each turn
# sends only the system prompt + the new user message (messages still saved).
CONVERSATION_HISTORY_WINDOW_ENABLED=true
# How many recent messages are re-sent when the window is enabled.
CONVERSATION_HISTORY_WINDOW_SIZE=20
# Max characters allowed in a single user message.
CONVERSATION_MAX_MESSAGE_CHARS=4000

# notification
NOTIFICATION_PROVIDER=firebase
FIREBASE_CREDENTIALS_FILE=
FIREBASE_PROJECT_ID=

# device trust
# Days a device stays trusted (is_verified) after passing 2FA before it must
# re-verify via OTP on next login. <= 0 disables the TTL (trust never expires by age).
TRUST_DEVICE_TTL=30

# ── Logging ──────────────────────────────────────────────────────────
# NOTE: the code reads LOG_FILE (not the legacy LOG_FILE_PATH above).
# Path to the persistent log file. Alloy tails this to ship logs to Loki.
# Leave blank to log to stdout only.
LOG_FILE=./logs/app.log
# Per-destination encodings. Default split: console readable, file machine-parsable.
#   console: text | json   (default text)
#   file:    text | json   (default json — required for Alloy's JSON parsing)
LOG_CONSOLE_FORMAT=text
LOG_FILE_FORMAT=json
# LOG_FORMAT, if set, OVERRIDES both above (uniform mode). Leave blank normally.
LOG_FORMAT=

# ── Observability (metrics + tracing) ────────────────────────────────
# Identity attached to metrics build_info and trace resource attributes.
OBS_SERVICE_NAME=math-svr
OBS_SERVICE_VERSION=dev
OBS_ENV=local

# Metrics (Prometheus). Served on a DEDICATED listener, separate from the API
# port and free of app middleware.
OBS_METRICS_ENABLED=true
# LOCAL: ":9091" (all interfaces) so Prometheus-in-Docker can scrape via
# host.docker.internal:9091.
# PRODUCTION: bind to loopback → "127.0.0.1:9091" so /metrics is NOT reachable
# from the public internet; scrape it with a node-local Prometheus/agent.
OBS_METRICS_ADDR=:9091

# Tracing (OpenTelemetry → Tempo via OTLP/HTTP).
OBS_TRACING_ENABLED=true
# host:port of the OTLP HTTP receiver (no scheme). LOCAL: localhost:4318.
# PRODUCTION: your collector/agent endpoint (NOT host.docker.internal).
OBS_OTLP_ENDPOINT=localhost:4318
# true → no TLS (local). PRODUCTION with a TLS collector: false.
OBS_OTLP_INSECURE=true
# Head sampling ratio. LOCAL: 1.0 (sample everything). PRODUCTION: 0.05–0.1.
# ParentBased is applied, so an upstream sampling decision is always honoured.
OBS_TRACE_SAMPLE_RATIO=1.0


