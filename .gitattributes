# The deploy pipeline rsyncs deploy/, docker/ and migrations/ verbatim onto a
# Linux host, where bash, systemd, nginx, logrotate and docker compose all
# choke on CRLF. Pin every text file to LF on checkout so a Windows clone
# (core.autocrlf=true) cannot ship CRLF to the server.
* text=auto eol=lf

# Binary payloads must never be normalized.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.pem  binary
*.key  binary
*.p12  binary
